# oh-my-agent project configuration example
# Copy this file to .oh-my-agent.toml in your project root and customize.
# This file is read once on startup and overrides global defaults.

[model]
# GGUF model filename, resolved relative to the models directory.
# Recommended for 16 GB VRAM: Qwen2.5-Coder-14B Q6_K (~12 GB).
# See issue #8 for the full catalog of validated models.
file = "Qwen2.5-Coder-7B-Instruct-Q5_K_M.gguf"

# Context window (tokens). Reduce if you run out of VRAM.
context_size = 16384

# GPU layers to offload. -1 = all, 0 = CPU only.
n_gpu_layers = -1

[provider]
# Backend: "vulkan" (default, works on Bazzite out-of-the-box)
#          "rocm"   (requires rpm-ostree install, see issue #11)
backend = "vulkan"

[session]
# Maximum turns per agent loop before hard stop.
max_turns = 50

# Persist conversation history across restarts.
persist = true
